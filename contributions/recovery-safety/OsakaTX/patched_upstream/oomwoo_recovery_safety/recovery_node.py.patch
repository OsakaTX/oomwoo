+    def _health_stale_republish(self) -> None:
+        """Bounded re-announce of the last event-stamped beat (pause note).
+
+        A paused robot emits no further work events, so the last heartbeat
+        would otherwise go silent mid-pause. Re-publish the SAME measured
+        stamp at most once per STALE_REPUBLISH_SEC, marked "stale-repub", so
+        consumers see node liveness without a counterfeit freshness claim.
+        """
+        beat = self._health.heartbeat_now()
+        if beat is None:
+            return
+        now = self._now_sec()
+        if now - beat.stamp_sec < STALE_REPUBLISH_SEC:
+            return
+        payload = beat.to_payload()
+        payload["detail"] = ("stale-repub;" + payload["detail"]) if payload["detail"] else "stale-repub"
+        self._health_pub.publish(String(data=json.dumps(payload, sort_keys=True)))
 
