<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schemas/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oomwoo_bench_probe</name>
  <version>0.1.0</version>
  <description>OOMWOO compute-benchmark fixtures: odom/tf probe replicating
    slam_toolbox GetPoseHelper::getOdomPose, plus language/process-layout
    worker nodes (rclcpp standalone + composable component).</description>
  <maintainer email="osakatex@users.noreply.github.com">OsakaTX</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
